# ---- Toss Securities Open API ----
# Register a client in 토스증권 WTS: 설정 > Open API to issue client_id/client_secret.
# TOSS_APP_KEY = client_id, TOSS_APP_SECRET = client_secret.
TOSS_APP_KEY=your-toss-client-id
TOSS_APP_SECRET=your-toss-client-secret
# Account seq — only for account-scoped calls (holdings/orders), sent as X-Tossinvest-Account.
TOSS_ACCOUNT_SEQ=
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_OAUTH_URL=https://openapi.tossinvest.com/oauth2/token
TOSS_TIMEOUT_S=10
TOSS_MAX_RETRIES=3

# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_DEEP=claude-opus-4-8
CLAUDE_MAX_TOKENS=2000
CLAUDE_MAX_CANDIDATES=8
# Soft monthly budget guard (USD). 0 disables the warning.
CLAUDE_MONTHLY_BUDGET_USD=20

# ---- Screening knobs (override without redeploying) ----
RSI_PERIOD=14
SMA_FAST=20
SMA_SLOW=60
RSI_OVERBOUGHT=70
VOLUME_RATIO_MIN=1.2
SCREEN_MIN_SCORE=0.0

# ---- Strategies (quant ensemble; comma list) ----
# Price-based: technical_swing, dual_momentum, canslim, mean_reversion,
#   trend_breakout, meb_faber, momentum_quality, low_volatility
# Fundamental (need FUNDAMENTALS_ENABLED + pip install ".[fundamentals]"):
#   graham, magic_formula, buffett_quality, piotroski
STRATEGY=technical_swing,dual_momentum,canslim,mean_reversion,trend_breakout,meb_faber,momentum_quality,low_volatility,graham,magic_formula,buffett_quality,piotroski
CANDLE_COUNT=0          # 0 = auto (>= a year of bars for the 252-day strategies)
# Dual momentum
DM_LOOKBACK_DAYS=252
DM_SKIP_DAYS=0
DM_ABS_THRESHOLD=0.0
DM_REQUIRE_TREND=true
# CAN SLIM (technical subset — no fundamentals)
CANSLIM_HIGH_PROXIMITY_PCT=0.15
CANSLIM_RS_MIN=0.70
CANSLIM_VOL_RATIO_MIN=1.5
CANSLIM_MAX_VIX=25.0
# Mean reversion
MEAN_REV_RSI_LOW=35.0
# Trend breakout
BREAKOUT_LOOKBACK=252
BREAKOUT_VOL_RATIO_MIN=1.5
# Market regime (VIX based)
REGIME_NEUTRAL_VIX=20.0
REGIME_RISKOFF_VIX=28.0
REGIME_RISKOFF_WEIGHT=0.5
# Investment-master (price-based): Meb Faber trend, momentum quality, low-vol,
# and the risk-parity (inverse-vol) suggested-weights overlay.
MEB_FABER_MA=200
MOMQ_LOOKBACK=252
MOMQ_SKIP=21
LOWVOL_LOOKBACK=126
RISK_PARITY_LOOKBACK=63
# Investment-master (fundamental): need pykrx (KRX) / yfinance (US). Lazy-imported
# and skipped gracefully if missing. Install: pip install -e ".[fundamentals]"
FUNDAMENTALS_ENABLED=true
GRAHAM_MAX_PE=15.0
GRAHAM_MAX_PB=1.5
BUFFETT_MIN_ROE=0.15
PIOTROSKI_MIN_SCORE=5

# ---- Runtime ----
# MARKET: KRX, US, or BOTH
MARKET=BOTH
LOOP_INTERVAL_MIN=30
REPORTS_DIR=./reports
LOG_LEVEL=INFO
LOG_FILE=./logs/tossai.log

# ---- Safety ----
# Hard guard. MUST stay false in v1 — the app refuses to start if true.
ENABLE_TRADING=false

# ---- Alerts ----
# Comma-separated channels: console,webhook,smtp,slack
ALERT_CHANNELS=console
# Only BUY/SELL with confidence >= this are pushed to webhook/smtp.
ALERT_MIN_CONFIDENCE=0.6
# Slack/Discord incoming webhook URL (used when 'webhook' is in ALERT_CHANNELS).
WEBHOOK_URL=

# SMTP (optional, used when 'smtp' is in ALERT_CHANNELS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ---- Slack (interactive app + proactive posts) ----
# Set true and run `python -m tossai serve` to enable the Slack server + scheduler.
SLACK_ENABLED=false
# Bot User OAuth Token (xoxb-...) — scopes: commands, chat:write
SLACK_BOT_TOKEN=
# App Signing Secret — used to verify inbound slash-command requests
SLACK_SIGNING_SECRET=
# Channel id (Cxxxxx) or #name for proactive briefings/risk alerts
SLACK_CHANNEL=
# Bind to localhost; put nginx/TLS in front for Slack's public HTTPS requirement
SLACK_APP_HOST=127.0.0.1
SLACK_APP_PORT=8080
SLACK_MAX_CONCURRENT_RUNS=2

# ---- Scheduler / briefings (used by `serve`) ----
BRIEFING_MARKET=KRX
BRIEFING_MORNING_TIME=08:30
BRIEFING_WEEKLY_DAY=mon
BRIEFING_WEEKLY_TIME=08:00

# ---- Risk alerts ----
RISK_SCAN_INTERVAL_MIN=15
VIX_BLACKSWAN_THRESHOLD=30.0
GAP_DOWN_PCT=5.0
VIX_SOURCE_URL=https://stooq.com/q/l/?s=^vix&f=sd2t2ohlcv&e=csv
