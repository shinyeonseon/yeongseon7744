# ---- Toss Securities Open API ----
# Apply at https://corp.tossinvest.com/ko/open-api and paste your credentials here.
TOSS_APP_KEY=your-toss-app-key
TOSS_APP_SECRET=your-toss-app-secret
# Account sequence/number — only needed for account-scoped calls (balances etc.).
TOSS_ACCOUNT_SEQ=
TOSS_BASE_URL=https://openapi.tossinvest.com/v1
# OAuth token endpoint. TODO(schema): confirm exact path from live docs.
TOSS_OAUTH_URL=https://openapi.tossinvest.com/v1/oauth/token
TOSS_TIMEOUT_S=10
TOSS_MAX_RETRIES=3

# ---- Anthropic / Claude ----
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MODEL_DEEP=claude-opus-4-8
CLAUDE_MAX_TOKENS=2000
CLAUDE_MAX_CANDIDATES=8
# Soft monthly budget guard (USD). 0 disables the warning.
CLAUDE_MONTHLY_BUDGET_USD=20

# ---- Screening knobs (override without redeploying) ----
RSI_PERIOD=14
SMA_FAST=20
SMA_SLOW=60
RSI_OVERBOUGHT=70
VOLUME_RATIO_MIN=1.2
SCREEN_MIN_SCORE=0.0

# ---- Runtime ----
# MARKET: KRX, US, or BOTH
MARKET=BOTH
LOOP_INTERVAL_MIN=30
REPORTS_DIR=./reports
LOG_LEVEL=INFO
LOG_FILE=./logs/tossai.log

# ---- Safety ----
# Hard guard. MUST stay false in v1 — the app refuses to start if true.
ENABLE_TRADING=false

# ---- Alerts ----
# Comma-separated channels: console,webhook,smtp
ALERT_CHANNELS=console
# Only BUY/SELL with confidence >= this are pushed to webhook/smtp.
ALERT_MIN_CONFIDENCE=0.6
# Slack/Discord incoming webhook URL (used when 'webhook' is in ALERT_CHANNELS).
WEBHOOK_URL=

# SMTP (optional, used when 'smtp' is in ALERT_CHANNELS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
